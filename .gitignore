# ── Secrets & environment files ─────────────────────────────────────────────
# NEVER commit .env files — they may contain secrets (API keys, JWT secrets, etc.)
.env
.env.local
.env.*.local
*.env
!.env.example        # .env.example files ARE committed — they contain no secrets

# ── Python ───────────────────────────────────────────────────────────────────
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
env/
venv/
.venv/
ENV/
*.egg-info/
dist/
build/
.pytest_cache/
.mypy_cache/
.ruff_cache/
htmlcov/
.coverage
coverage.xml
*.log

# ── Node / frontend ──────────────────────────────────────────────────────────
node_modules/
frontend/dist/
frontend/.vite/
frontend/build/
*.tsbuildinfo
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# ── Docker ───────────────────────────────────────────────────────────────────
# Do NOT ignore docker-compose overrides that contain secrets
docker-compose.override.yml

# ── IDE & OS ─────────────────────────────────────────────────────────────────
.vscode/
.idea/
*.swp
*.swo
.DS_Store
Thumbs.db
desktop.ini

# ── Temporary files ──────────────────────────────────────────────────────────
*.tmp
*.bak
test_results.txt
build_check.txt
tsc_check.txt
