# Copy this file to .env and adjust as needed.
# The app works without any .env — all values have sensible defaults.

# CORS — comma-separated origins allowed to call the API
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# Day-ahead cutoff hour (UTC, 0-23). Default 9 = 09:00 UTC on D-1.
# See Assumption A1 in data_model.md
DEFAULT_CUTOFF_HOUR_UTC=9

# Elexon API base URL (do not change unless testing against a mirror)
ELEXON_BASE_URL=https://data.elexon.co.uk/bmrs/api/v1

# HTTP timeout for Elexon requests (seconds)
ELEXON_TIMEOUT_SECONDS=60.0

# Max retries on transient Elexon errors
ELEXON_MAX_RETRIES=3
